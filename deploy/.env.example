# ==============================================================================
# Zorven self-host yapilandirmasi (.env)
# Bu dosyayi `deploy/.env` olarak kopyalayin ve degerleri DEGISTIRIN.
# Gizli degerleri (parola, anahtar) ASLA git'e eklemeyin.
# ==============================================================================

# 1. Temel Platform Ayarlari
# Tunel alt alanlari <ad>.<PLATFORM_DOMAIN> olur; DNS'te joker kayit (*.alan) gerekir.
PLATFORM_DOMAIN=example.com
# Platform yonetici anahtari. Uretin: openssl rand -hex 32
ADMIN_KEY=change_me_openssl_rand_hex_32
# Let's Encrypt (ozel domain sertifikalari) icin iletisim adresi
ACME_EMAIL=admin@example.com

# 2. Veritabani
POSTGRES_USER=zorven
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=zorven
POSTGRES_PORT=5432

# 3. Kimlik Dogrulama (Better Auth - web/Nitro servisi)
# En az 32 karakterlik gizli anahtar. Uretin: openssl rand -hex 32
BETTER_AUTH_SECRET=change_me_openssl_rand_hex_32_min_32_chars
# Gonderen kimligi (kendi Postfix'inizden). no-reply@<PLATFORM_DOMAIN> onerilir.
SMTP_FROM=Zorven <no-reply@example.com>
# Sosyal giris (opsiyonel - bos birakilirsa ilgili buton gizlenir)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 4. Secret Vault (opsiyonel) - base64 kodlanmis 32 bayt. Uretin: openssl rand -base64 32
# Bos ise secret olusturma 503 doner; policy motoru bundan bagimsiz calisir.
ZORVEN_SECRET_KEY=

# 5. Log saklama suresi (gun). Varsayilan 30; 0 = temizlik kapali.
# ZORVEN_LOG_RETENTION_DAYS=30

# 6. Geo/IP (opsiyonel, varsayilan KAPALI)
# Zorven hicbir GeoIP veritabani DAGITMAZ. Kullanmak isterseniz bir mmdb dosyasi
# saglayip yolunu asagiya yazin ve konteynere bind-mount edin.
# Kaynak secimi ve lisansi ISLETMECIYE aittir:
#   DB-IP Lite       - CC BY 4.0, serbestce dagitilabilir (onerilen)
#   IPinfo Lite      - CC BY-SA 4.0
#   MaxMind GeoLite2 - hesap + lisans anahtari gerekir
# Tanimsizsa Geo kosullari eslesmez ve istekler normal akar (deny TETIKLENMEZ).
# ZORVEN_GEOIP_DB=/data/geo/country-asn.mmdb

# 7. IP listeleri (opsiyonel, varsayilan KAPALI)
# tor_exit / hosting / reputation kosullari bu listelerden beslenir.
# Zorven hicbir liste DAGITMAZ; kaynak ve lisansi ISLETMECIYE aittir.
# Kaynak bir URL veya yerel dosya yolu olabilir; virgulle coklu verilebilir.
# Tanimsizsa ilgili kosullar eslesmez ve istekler normal akar (deny TETIKLENMEZ).
# Liste yenilenemezse ESKI anlik goruntu korunur (fail-stale), bosalmaz.
#
# ZORVEN_IPSET_TOR=https://check.torproject.org/torbulkexitlist
# ZORVEN_IPSET_HOSTING=/data/ipsets/datacenter.txt
# ZORVEN_IPSET_REPUTATION=spamhaus=/data/ipsets/drop.txt,abuse=https://ornek/liste.txt
# ZORVEN_IPSET_REFRESH=6h
# ZORVEN_IPSET_CACHE=/data/ipsets/cache
