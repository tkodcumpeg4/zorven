# ==============================================================================
# Zorven VPS / Multi-Node Dağıtık Küme Yapılandırması (.env)
# ==============================================================================

# 1. Temel Platform Ayarları
PLATFORM_DOMAIN=zorven.app
ADMIN_KEY=zrv_admin_supersecret_change_me_in_production
ACME_EMAIL=admin@zorven.app

# 2. Küme (Cluster) Güvenlik ve Düğüm Ayarları
# Bütün düğümlerde (Primary + Edge) AYNI olmalıdır!
CLUSTER_SECRET=zorven_cluster_shared_secret_generate_with_openssl_rand_hex_32

# Bu sunucunun düğüm kimliği (örn. vps-fra-1, vps-ist-1, vps-nyc-1)
NODE_ID=vps-node-1

# Bu sunucunun diğer sunucularca erişilebilir genel IP'si veya dahili hostname'i
PUBLIC_IP_OR_HOST=198.51.100.1

# 3. Veritabanı Ayarları (Primary Node İçin)
POSTGRES_USER=rpshell
POSTGRES_PASSWORD=zorven_db_secure_password_replace_me
POSTGRES_DB=rpshell
POSTGRES_PORT=5432

# 4. Edge Node İçin Primary DB Bağlantı Adresi (Yalnızca Edge VPS'lerde gereklidir)
# PRIMARY_DB_DSN=postgres://rpshell:zorven_db_secure_password_replace_me@198.51.100.1:5432/rpshell?sslmode=disable

# 5. Kimlik Doğrulama (Better Auth — web/Nitro servisi)
# En az 32 karakterlik gizli anahtar. Üret: openssl rand -hex 32
BETTER_AUTH_SECRET=change_me_openssl_rand_hex_32_min_32_chars
# Gönderen kimliği (kendi Postfix'imizden). no-reply@<PLATFORM_DOMAIN> önerilir.
SMTP_FROM=Zorven <no-reply@zorven.app>
# GitHub ile giriş (opsiyonel — boş bırakılırsa GitHub butonu gizlenir)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 6. Analytics (self-hosted Umami) — gizli anahtar. Üret: openssl rand -hex 32
UMAMI_APP_SECRET=change_me_openssl_rand_hex_32
